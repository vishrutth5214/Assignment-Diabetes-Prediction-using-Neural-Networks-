9. Age Risk Calculation

Age is used only as a synthetic contribution to the score.

def calculate_age_weight(age):

    if age is None:
        return 0

    if age >= 65:
        return 15

    elif age >= 50:
        return 10

    elif age >= 40:
        return 5

    else:
        return 0
10. Healthcare Assessment Tool

The following Python function is converted into a LangChain tool using the @tool decorator.

@tool
def healthcare_assessment(
    symptoms: List[str],
    age: int = None,
    symptom_duration: str = None,
    additional_information: str = ""
) -> str:
    """
    Performs a synthetic initial healthcare triage assessment.

    This tool does not diagnose medical conditions.
    It calculates an educational risk score based on
    predefined synthetic indicators.
    """

    # Normalize symptoms
    normalized_symptoms = [
        symptom.lower().strip()
        for symptom in symptoms
        if symptom and symptom.strip()
    ]

    matched_indicators = []
    categories = []
    score = 0

    # Match symptoms with severity weights
    for symptom in normalized_symptoms:

        if symptom in severity_weights:

            if symptom not in matched_indicators:
                matched_indicators.append(symptom)

            score += severity_weights[symptom]

        # Identify symptom categories
        for category, keywords in symptom_category_keywords.items():

            if symptom in keywords:

                if category not in categories:
                    categories.append(category)

    # Add age contribution
    age_weight = calculate_age_weight(age)
    score += age_weight

    # Add small duration contribution
    if symptom_duration:

        duration_lower = symptom_duration.lower()

        if (
            "four days" in duration_lower
            or "5 days" in duration_lower
            or "six days" in duration_lower
            or "week" in duration_lower
        ):
            score += 5

    # Keep score between 0 and 100
    score = min(score, 100)

    # Identify missing information
    missing_indicators = []

    if age is None:
        missing_indicators.append("patient age")

    if not symptom_duration:
        missing_indicators.append("symptom duration")

    if not normalized_symptoms:
        missing_indicators.append("specific symptoms")

    # Identify unknown symptoms
    unknown_symptoms = [
        symptom
        for symptom in normalized_symptoms
        if symptom not in severity_weights
    ]

    # Determine risk
    contains_high_risk = any(
        symptom in high_risk_indicators
        for symptom in matched_indicators
    )

    if len(matched_indicators) == 0:
        risk_level = "UNKNOWN"
        human_intervention_required = True

    elif contains_high_risk or score >= 60:
        risk_level = "HIGH"
        human_intervention_required = True

    elif score >= 25:
        risk_level = "MODERATE"
        human_intervention_required = False

    else:
        risk_level = "LOW"
        human_intervention_required = False

    # Structured result
    result = {
        "severity_score": score,
        "risk_level": risk_level,
        "matched_indicators": matched_indicators,
        "unknown_symptoms": unknown_symptoms,
        "categories": categories,
        "age_weight": age_weight,
        "missing_indicators": missing_indicators,
        "human_intervention_required": human_intervention_required
    }

    return json.dumps(result, indent=2)
